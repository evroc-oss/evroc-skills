#!/usr/bin/env bash
# Mock `evroc` CLI for skillgrade evals.
#
# - Records every invocation (one arg per line, under a ===CALL=== header) to
#   .evroc-calls.log in the workspace root (anchored by .agents/ or .claude/).
# - Tracks minimal resource state in .evroc-state/ so get/verify flows behave
#   realistically (e.g. vm get returns "not found" after vm delete).
# - Returns plausible YAML/list output for compute resources; generic success
#   for iam/storage/loadbalancer/rancher/think so negative-routing flows succeed.
#
# This shadows the real evroc CLI only when its directory is prepended to PATH.

set -u

# --- locate workspace root (dir containing .agents/ or .claude/) ---
root="$PWD"
d="$PWD"
while [ "$d" != "/" ]; do
  if [ -d "$d/.agents" ] || [ -d "$d/.claude" ]; then
    root="$d"; break
  fi
  d="$(dirname "$d")"
done
log="/tmp/.sgcalls-$(basename "$root").log"
state="$root/.evroc-state"
mkdir -p "$state" "$state/vm" "$state/disk" "$state/snapshot" "$state/placementgroup" "$state/attach"

# --- log this call: one arg per line under a header ---
{
  printf '===CALL===\n'
  for a in "$@"; do printf '%s\n' "$a"; done
} >> "$log"

# --- helpers ---
has() { # returns 0 if any arg equals $1
  local needle="$1"; shift
  for x in "$@"; do [ "$x" = "$needle" ] && return 0; done
  return 1
}
flagval() { # prints value of --flag=value or --flag value
  local f="$1"; shift
  local prev=""
  for x in "$@"; do
    if [ "$prev" = "$f" ]; then printf '%s' "$x"; return; fi
    case "$x" in
      "$f"=*) printf '%s' "${x#$f=}"; return;;
    esac
    prev="$x"
  done
}
disk_args() { # prints all --disk=NAME / --disk NAME values
  local prev=""
  for x in "$@"; do
    case "$x" in
      --disk=*) printf '%s\n' "${x#--disk=}";;
      --disk)
        : # value comes next, handled below
        ;;
      *)
        if [ "$prev" = "--disk" ]; then printf '%s\n' "$x"; fi
        ;;
    esac
    prev="$x"
  done
}

# normalize a resource word (vm/virtualmachine/instance -> vm; disk -> disk; etc)
norm_res() {
  case "$1" in
    vm|virtualmachine|virtualmachines|instance|instances) printf 'vm';;
    disk|disks) printf 'disk';;
    snapshot|snapshots) printf 'snapshot';;
    placementgroup|placementgroups|pg) printf 'placementgroup';;
    *) printf '%s' "$1";;
  esac
}

service="${1:-}"
res="${2:-}"
action="${3:-}"
name="${4:-}"

# --- auth/config commands (always succeed, no resource state) ---
case "$service" in
  login)
    echo "Logged in."
    exit 0
    ;;
  config)
    case "$res" in
      current-project) echo "eval-project";;
      set-project) echo "ok";;
      show)
        printf 'project: eval-project\nregion: se-sto\nzones:\n  - a\n  - b\n'
        ;;
      get)
        key="${3:-}"
        case "$key" in
          project) echo "eval-project";;
          region) echo "se-sto";;
          zone|zones) echo "a b";;
          "") printf 'project: eval-project\nregion: se-sto\nzones:\n  - a\n  - b\n';;
          *) echo "ok";;
        esac
        ;;
      *) echo "ok";;
    esac
    exit 0
    ;;
  --version|-v|version) echo "evroc 0.0.0-mock"; exit 0;;
  "") echo "evroc mock CLI"; exit 0;;
esac

# --- compute service: full state tracking ---
if [ "$service" = "compute" ]; then
  r="$(norm_res "$res")"
  name="${4:-}"
  mkdir -p "$state/vm" "$state/disk" "$state/snapshot" "$state/placementgroup"

  case "$r" in
    vm)
      case "$action" in
        create|new)
          touch "$state/vm/$name"
          : > "$state/attach/$name"
          for d in $(disk_args "$@"); do echo "$d" >> "$state/attach/$name"; done
          echo "Virtual machine '$name' created."
          ;;
        list|ls)
          if has -o "$@" && [ "$(flagval -o "$@")" = "yaml" -o "$(flagval -o "$@")" = "json" ]; then
            echo "items:"
            for f in "$state/vm"/*; do [ -e "$f" ] && echo "  - name: $(basename "$f")"; done
          else
            for f in "$state/vm"/*; do [ -e "$f" ] && basename "$f"; done
          fi
          ;;
        get)
          if [ -f "$state/vm/$name" ]; then
            z="$(flagval --zone "$@")"; [ -z "$z" ] && z="a"
            printf 'name: %s\nstatus: Running\nzone: %s\n' "$name" "$z"
            printf 'disks:\n'
            if [ -f "$state/attach/$name" ]; then
              while read -r dn; do [ -n "$dn" ] && printf '  - %s\n' "$dn"; done < "$state/attach/$name"
            fi
          else
            echo "not found"; exit 1
          fi
          ;;
        update|u)
          if has --append "$@"; then
            for d in $(disk_args "$@"); do echo "$d" >> "$state/attach/$name"; done
          fi
          echo "Virtual machine '$name' updated."
          ;;
        delete|del|rm)
          rm -f "$state/vm/$name" "$state/attach/$name"
          echo "Virtual machine '$name' deleted."
          ;;
        *) echo "ok";;
      esac
      exit 0
      ;;
    disk)
      case "$action" in
        create|new)
          touch "$state/disk/$name"
          echo "Disk '$name' created."
          ;;
        list|ls)
          for f in "$state/disk"/*; do [ -e "$f" ] && basename "$f"; done
          ;;
        get)
          if [ -f "$state/disk/$name" ]; then
            printf 'name: %s\nsize: 50GB\nzone: a\n' "$name"
          else
            echo "not found"; exit 1
          fi
          ;;
        update|u) echo "Disk '$name' updated.";;
        delete|del|rm)
          rm -f "$state/disk/$name"
          echo "Disk '$name' deleted."
          ;;
        *) echo "ok";;
      esac
      exit 0
      ;;
    snapshot)
      case "$action" in
        create|new) touch "$state/snapshot/$name"; echo "Snapshot '$name' created.";;
        list|ls) for f in "$state/snapshot"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/snapshot/$name" ] && echo "name: $name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/snapshot/$name"; echo "Snapshot '$name' deleted.";;
        *) echo "ok";;
      esac
      exit 0
      ;;
    placementgroup)
      case "$action" in
        create|new) touch "$state/placementgroup/$name"; echo "Placement group '$name' created.";;
        list|ls) for f in "$state/placementgroup"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/placementgroup/$name" ] && echo "name: $name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/placementgroup/$name"; echo "Placement group '$name' deleted.";;
        *) echo "ok";;
      esac
      exit 0
      ;;
  esac
fi

# --- iam service: projects, rolebindings, serviceaccounts, credentials ---
if [ "$service" = "iam" ]; then
  mkdir -p "$state/project" "$state/rb" "$state/sa" "$state/sacred"
  case "$res" in
    project)
      case "$action" in
        create|new) touch "$state/project/$name"; echo "Project '$name' created.";;
        list|ls)
          for f in "$state/project"/*; do [ -e "$f" ] && basename "$f"; done;;
        get)
          [ -f "$state/project/$name" ] && printf 'id: %s\nname: %s\n' "$name" "$name" || { echo "not found"; exit 1; };;
        update|u) echo "Project '$name' updated.";;
        delete|del|rm) rm -f "$state/project/$name"; echo "Project '$name' deleted.";;
        *) echo "ok";;
      esac; exit 0;;
    rb|rolebinding|rolebindings)
      case "$action" in
        assign)
          p="$(flagval --principal "$@")"; r="$(flagval --role "$@")"
          rbid="rb-$(echo "$p$r" | md5 2>/dev/null | head -c8 || echo "$RANDOM")"
          touch "$state/rb/$rbid"
          printf '%s\n%s\n%s\n' "$p" "$r" > "$state/rb/$rbid"
          echo "Role binding assigned: $p -> $r";;
        revoke)
          echo "Role binding revoked.";;
        list|ls)
          for f in "$state/rb"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/rb/$name" ] && cat "$state/rb/$name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/rb/$name"; echo "Role binding '$name' deleted.";;
        roles)
          echo "/iam/roles/projectOwner    project   141"
          echo "/iam/roles/computeOperator  project   27"
          echo "/iam/roles/storageOperator   project   28"
          echo "/iam/roles/organizationOwner organization 23"
          echo "/iam/roles/organizationViewer organization 7"
          ;;
        list-me) echo "No role bindings found.";;
        *) echo "ok";;
      esac; exit 0;;
    serviceaccount|serviceaccounts|sa)
      case "$action" in
        create|new) touch "$state/sa/$name"; echo "Service account '$name' created.";;
        list|ls) for f in "$state/sa"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/sa/$name" ] && echo "id: $name" || { echo "not found"; exit 1; };;
        update|u) echo "Service account '$name' updated.";;
        delete|del|rm) rm -f "$state/sa/$name"; echo "Service account '$name' deleted.";;
        label) echo "Labels updated.";;
        credential|credentials)
          cred_act="${4:-}"
          cred="${5:-}"
          case "$cred_act" in
            create|new)
              touch "$state/sacred/$cred"
              echo "Credential '$cred' created (expires in $(flagval --expires-in "$@" 2>/dev/null || echo 8760h)).";;
            list|ls) for f in "$state/sacred"/*; do [ -e "$f" ] && basename "$f"; done;;
            get) [ -f "$state/sacred/$cred" ] && echo "id: $cred" || { echo "not found"; exit 1; };;
            revoke|rev) echo "Credential '$cred' revoked.";;
            delete|del|rm) rm -f "$state/sacred/$cred"; echo "Credential '$cred' deleted.";;
            *) echo "ok";;
          esac;;
        *) echo "ok";;
      esac; exit 0;;
    get-access-token) echo "eyJhbGciOiJSUzI1NiJ9.mock-token"; exit 0;;
    get-user-info) printf 'id: /iam/users/mock-user\nemail: user@evroc.com\n'; exit 0;;
    *) echo "ok"; exit 0;;
  esac
fi

# --- storage service: buckets, filestores, bucket SAs ---
if [ "$service" = "storage" ]; then
  mkdir -p "$state/bucket" "$state/filestore" "$state/bsa"
  case "$res" in
    bucket)
      case "$action" in
        create|new)
          touch "$state/bucket/$name"
          echo "Bucket '$name' created.";;
        list|ls)
          for f in "$state/bucket"/*; do [ -e "$f" ] && basename "$f"; done;;
        get)
          [ -f "$state/bucket/$name" ] && printf 'name: %s\nretention: Disabled\n' "$name" || { echo "not found"; exit 1; };;
        delete|del|rm)
          rm -f "$state/bucket/$name"
          echo "Bucket '$name' deleted.";;
        copy|cp) echo "Copy complete.";;
        get-s3-credentials|s3-creds)
          echo "S3 credentials written to ~/.evroc/credentials.ini";;
        update|u) echo "Bucket '$name' updated.";;
        label) echo "Labels updated.";;
        *) echo "ok";;
      esac; exit 0;;
    filestore|filestores)
      case "$action" in
        create|new) touch "$state/filestore/$name"; echo "File store '$name' created.";;
        list|ls) for f in "$state/filestore"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/filestore/$name" ] && echo "name: $name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/filestore/$name"; echo "File store '$name' deleted.";;
        *) echo "ok";;
      esac; exit 0;;
    bucketserviceaccount|bucketserviceaccounts|bsa)
      case "$action" in
        create|new) touch "$state/bsa/$name"; echo "Bucket service account '$name' created.";;
        list|ls) for f in "$state/bsa"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/bsa/$name" ] && echo "id: $name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/bsa/$name"; echo "Bucket service account '$name' deleted.";;
        update|u) echo "Bucket service account '$name' updated.";;
        *) echo "ok";;
      esac; exit 0;;
    bucketserviceaccountsecret|bsas) echo "ok"; exit 0;;
    *) echo "ok"; exit 0;;
  esac
fi

# --- loadbalancer service: loadbalancers, backendpools, backendservices, l4routes ---
if [ "$service" = "loadbalancer" ]; then
  mkdir -p "$state/lb" "$state/bp" "$state/bs" "$state/l4r" "$state/listener"
  case "$res" in
    loadbalancer|lb|loadbalancers)
      case "$action" in
        create|new) touch "$state/lb/$name"; echo "Load balancer '$name' created.";;
        list|ls) for f in "$state/lb"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/lb/$name" ] && printf 'name: %s\nstatus: Active\n' "$name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/lb/$name"; echo "Load balancer '$name' deleted.";;
        addlistener)
          ln="$(flagval --listener-name "$@")"
          [ -n "$ln" ] && touch "$state/listener/${name}_${ln}"
          echo "Listener '$ln' added to '$name'.";;
        removelistener)
          ln="$(flagval --listener-name "$@")"
          rm -f "$state/listener/${name}_${ln}"
          echo "Listener '$ln' removed from '$name'.";;
        *) echo "ok";;
      esac; exit 0;;
    backendpool|bp|backendpools)
      case "$action" in
        create|new) touch "$state/bp/$name"; echo "Backend pool '$name' created.";;
        list|ls) for f in "$state/bp"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/bp/$name" ] && echo "name: $name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/bp/$name"; echo "Backend pool '$name' deleted.";;
        update|u) echo "Backend pool '$name' updated.";;
        *) echo "ok";;
      esac; exit 0;;
    backendservice|bs|backendservices)
      case "$action" in
        create|new) touch "$state/bs/$name"; echo "Backend service '$name' created.";;
        list|ls) for f in "$state/bs"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/bs/$name" ] && echo "name: $name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/bs/$name"; echo "Backend service '$name' deleted.";;
        sethealthcheckhttp) echo "HTTP health check set for '$name'.";;
        sethealthchecktcp) echo "TCP health check set for '$name'.";;
        clearhealthcheck) echo "Health check cleared for '$name'.";;
        *) echo "ok";;
      esac; exit 0;;
    l4route|l4r|l4routes)
      case "$action" in
        create|new) touch "$state/l4r/$name"; echo "L4 route '$name' created.";;
        list|ls) for f in "$state/l4r"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/l4r/$name" ] && echo "name: $name" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/l4r/$name"; echo "L4 route '$name' deleted.";;
        *) echo "ok";;
      esac; exit 0;;
    *) echo "ok"; exit 0;;
  esac
fi

# --- networking service: public IPs (used by loadbalancer skill) ---
if [ "$service" = "networking" ]; then
  mkdir -p "$state/publicip"
  case "$res" in
    publicip|publicips|ip)
      case "$action" in
        create|new) touch "$state/publicip/$name"; echo "Public IP '$name' created.";;
        list|ls) for f in "$state/publicip"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/publicip/$name" ] && printf 'name: %s\naddress: 10.0.0.%s\n' "$name" "$((RANDOM % 250 + 1))" || { echo "not found"; exit 1; };;
        delete|del|rm) rm -f "$state/publicip/$name"; echo "Public IP '$name' deleted.";;
        *) echo "ok";;
      esac; exit 0;;
    *) echo "ok"; exit 0;;
  esac
fi

# --- think service: apikeys, instances, models, sharedmodels, sizes ---
if [ "$service" = "think" ]; then
  mkdir -p "$state/think-apikey" "$state/think-instance"
  case "$res" in
    apikey|apikeys|key)
      case "$action" in
        create|new) touch "$state/think-apikey/$name"; echo "API key '$name' created.";;
        list|ls) for f in "$state/think-apikey"/*; do [ -e "$f" ] && basename "$f"; done;;
        delete|del|rm) rm -f "$state/think-apikey/$name"; echo "API key '$name' deleted.";;
        *) echo "ok";;
      esac; exit 0;;
    instance|instances)
      case "$action" in
        create|new) touch "$state/think-instance/$name"; echo "Instance '$name' created (Provisioning).";;
        list|ls) for f in "$state/think-instance"/*; do [ -e "$f" ] && basename "$f"; done;;
        get) [ -f "$state/think-instance/$name" ] && printf 'name: %s\nstatus: Running\n' "$name" || { echo "not found"; exit 1; };;
        start) echo "Instance '$name' starting.";;
        stop) echo "Instance '$name' stopping.";;
        update|u) echo "Instance '$name' updated.";;
        delete|del|rm) rm -f "$state/think-instance/$name"; echo "Instance '$name' deleted.";;
        *) echo "ok";;
      esac; exit 0;;
    model|models)
      case "$action" in
        list|ls)
          echo "mistralai/Ministral-8B-Instruct-2410   8B   128k"
          echo "mistralai/Mistral-Small-3.1-24B-Instruct-2503  24B  128k"
          echo "meta-llama/Llama-3.3-70B-Instruct      70B  128k"
          ;;
        get) printf 'id: %s\ncontext: 128000\n' "$name";;
        *) echo "ok";;
      esac; exit 0;;
    sharedmodel|sharedmodels)
      case "$action" in
        list|ls)
          echo "mistral-small-latest   Ready   mistralai/Mistral-Small-3.1-24B-Instruct-2503"
          echo "llama-3.3-70b-latest   Ready   meta-llama/Llama-3.3-70B-Instruct"
          ;;
        *) echo "ok";;
      esac; exit 0;;
    size|sizes)
      case "$action" in
        list|ls)
          echo "1-b200-27c-240g    1x B200   27 vCPU   240GB"
          echo "2-b200-54c-480g    2x B200   54 vCPU   480GB"
          echo "1-h100-32c-640g   1x H100   32 vCPU   640GB"
          echo "2-h100-64c-1280g  2x H100   64 vCPU  1280GB"
          ;;
        *) echo "ok";;
      esac; exit 0;;
    code)
      echo "Coding agent launched with Think model backend."
      exit 0;;
    *) echo "ok"; exit 0;;
  esac
fi

# --- rancher service: not a CLI service per se, but handle gracefully ---
if [ "$service" = "rancher" ]; then
  echo "ok"
  exit 0
fi

# fallback
echo "ok"
exit 0
